# 复制为 .env 后填写（.env 不会进 git；部署时 scripts/deploy_server.sh --with-env 上传到服务器，权限 600）

# 告警渠道（都可选，留空则只写日志）
MM_ALERT_PUSHPLUS_TOKEN=
MM_ALERT_FEISHU_WEBHOOK=
MM_ALERT_WEBHOOK=
# 邮件（Gmail 需用应用专用密码：https://myaccount.google.com/apppasswords）
MM_ALERT_SMTP_USER=
MM_ALERT_SMTP_PASSWORD=
MM_ALERT_EMAIL_TO=

# LLM 中转站（OpenAI 兼容接口），只有启用 1.0 的 S2/S3 策略时才需要
MM_LLM_BASE_URL=https://your-relay.example.com/v1
MM_LLM_API_KEY=sk-xxxx

# OKX API（只读权限，用于实盘工程的只读模式）
MM_OKX_API_KEY=
MM_OKX_SECRET_KEY=
MM_OKX_PASSPHRASE=
